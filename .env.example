NEXT_PUBLIC_APP_URL=http://localhost:3000
# Neon Postgres (use one)
NEON_DATABASE_URL=
DATABASE_URL=
ENCRYPTION_KEY=replace-with-32-char-secret
WARM_POOL_SIZE=5
# OpenRouter for AI-powered skill/heartbeat generation
PLATFORM_OPENROUTER_API_KEY=
BRAND_CONTENT_MODEL=openai/gpt-5.2
BRAND_RESEARCH_PIPELINE_ENABLED=1
RESEARCH_CRAWLER_ENGINE=adaptive
# adaptive | cheerio | playwright | basic
# Set to 1 to probe common guessed paths like /about, /pricing, /docs.
RESEARCH_ENABLE_GUESS_PATHS=0
EXECUTION_MODE=mock
RUNTIME_CONTROLLER_URL=
RUNTIME_CONTROLLER_TOKEN=
RUNTIME_CALLBACK_TOKEN=dev-runtime-token
RUNTIME_STATUS_CALLBACK_URL=
OPENCLAW_RUNTIME_IMAGE=ghcr.io/openclaw/openclaw:latest
INTERNAL_BOT_TOKEN=

# X (Twitter) OAuth for posting/replying on connected user accounts
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must match your X app callback URL exactly
X_REDIRECT_URI=http://localhost:3000/api/x/callback
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access
X_POST_COOLDOWN_MINUTES=60
X_REPLY_COOLDOWN_MINUTES=3
X_CONTENT_DEDUPE_WINDOW_HOURS=24
X_REPLY_THREAD_USER_LIMIT=1

# Dodo Payments (subscriptions)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENV=test
# base64 secret from Dodo dashboard (Standard Webhooks)
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_BILLING_CURRENCY=USD

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STARTER_MONTHLY=
PAYPAL_PLAN_STARTER_YEARLY=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_YEARLY=

# Razorpay (kept for future switching)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_TEST_MODE=0
